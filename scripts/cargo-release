#!/usr/bin/env bash
set -euo pipefail

REQUIRED_OPEN_FILES=4096
current_open_files="$(ulimit -n)"

if [[ "$current_open_files" != "unlimited" && "$current_open_files" -lt "$REQUIRED_OPEN_FILES" ]]; then
  ulimit -n "$REQUIRED_OPEN_FILES"
fi

current_open_files="$(ulimit -n)"
if [[ "$current_open_files" != "unlimited" && "$current_open_files" -lt "$REQUIRED_OPEN_FILES" ]]; then
  echo "release build requires at least $REQUIRED_OPEN_FILES open files; available: $current_open_files" >&2
  exit 1
fi

if [[ "${1:-}" == "zigbuild" && "$(uname -s)" == "Darwin" ]]; then
  args=("$@")
  for ((i = 1; i < ${#args[@]}; i++)); do
    target=""
    if [[ "${args[i]}" == --target=* ]]; then
      target="${args[i]#--target=}"
    elif [[ "${args[i]}" == "--target" && $((i + 1)) -lt ${#args[@]} ]]; then
      target="${args[i + 1]}"
    fi

    if [[ "$target" == *-apple-darwin ]]; then
      args[0]="build"
      exec cargo "${args[@]}"
    fi
  done
fi

exec cargo "$@"
