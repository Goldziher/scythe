    ".opencode/skills/scythe/references/cli-reference.md",
    ".opencode/skills/scythe/references/configuration.md",
    ".opencode/skills/scythe/references/lint-rules.md",
    ".pi/skills/scythe/SKILL.md",
    ".pi/skills/scythe/index.md",
    ".pi/skills/scythe/references/annotations.md",
    ".pi/skills/scythe/references/backends.md",
    ".pi/skills/scythe/references/cli-reference.md",
    ".pi/skills/scythe/references/configuration.md",
    ".pi/skills/scythe/references/lint-rules.md",
    "README.md",
    "assets/"
