<?xml version="1.0" encoding="UTF-8"?>
<project
  xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
>
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.scythe</groupId>
  <artifactId>java-r2dbc-integration</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>r2dbc-postgresql</artifactId>
        <version>1.0.7.RELEASE</version>
      </dependency>
      <!-- The generated Queries.java/kt imports reactor.core.publisher.Mono/Flux
           directly, so this is a compile-time dependency of the generated code,
           not merely a transitive runtime dependency of the r2dbc driver. -->
      <dependency>
        <groupId>io.projectreactor</groupId>
        <artifactId>reactor-core</artifactId>
        <version>3.7.4</version>
      </dependency>
      <!-- The blocking JDBC driver as well, and not by accident: R2DBC has no
           way to run a multi-statement DDL script, so the harness sets the
           schema up over java.sql.DriverManager before any reactive code runs.
           Without this the project compiles and then dies at run time with
           "No suitable driver found for jdbc:...". -->
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>42.7.12</version>
      </dependency>
    <dependency>
      <groupId>com.google.code.findbugs</groupId>
      <artifactId>jsr305</artifactId>
      <version>3.0.2</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <mainClass>IntegrationTest</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
