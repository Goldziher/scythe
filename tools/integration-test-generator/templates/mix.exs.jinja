{%- elif driver == "tds" %}
      {:tds, "~> 2.3"},
{%- elif driver == "jamdb" %}
      {:jamdb_oracle, "~> 0.5.12"},
{%- elif driver == "ecto" %}
      {:ecto_sql, "~> 3.14"},
      {%- if engine == "postgresql" %}
      {:postgrex, "~> 0.22.4"},
      {%- elif engine == "mysql" %}
      {:myxql, "~> 0.9.0"},
      {%- elif engine == "sqlite" %}
      {:ecto_sqlite3, "~> 0.25.0"},
      {%- endif %}
{%- endif %}
      {:decimal, "~> 3.1"}
