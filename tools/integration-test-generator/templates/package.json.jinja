{
	"name": "scythe-integration-test-{{ driver }}{% if options.row_type %}-{{ options.row_type }}{% endif %}{% if options.outer_join_unions %}-outer-join-unions{% endif %}{% if options.structs_only %}-structs-only{% endif %}",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "tsx test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {% if driver == "node-sqlite" or (driver == "pg" and options.structs_only == "true" and options.row_type != "zod") %}{}{% else %}{
{%- if driver == "pg" and options.structs_only == "true" %}
{%- if options.row_type == "zod" %}
		"zod": "^3.25.76"
{%- endif %}
{%- elif driver == "pg" %}
		"pg": "^8.23.1"{% if options.row_type == "zod" %},
		"zod": "^3.25.76"{% endif %}
{%- elif driver == "kysely-pg" %}
		"kysely": "^0.28.17",
		"pg": "^8.23.1"
{%- elif driver == "postgres" %}
		"postgres": "^3.4.9"
{%- elif driver == "mysql2" %}
		"mysql2": "^3.24.5"
{%- elif driver == "kysely-mysql2" or driver == "kysely-mariadb" %}
		"kysely": "^0.28.17",
		"mysql2": "^3.24.5"
{%- elif driver == "better-sqlite3" %}
		"better-sqlite3": "^12.11.1"
{%- elif driver == "kysely-sqlite" %}
		"better-sqlite3": "^12.11.1",
		"kysely": "^0.28.17"
{%- elif driver == "wasm-sqlite" %}
		"@sqlite.org/sqlite-wasm": "^3.53.0-build1"
{%- elif driver == "duckdb" %}
		"@duckdb/node-api": "^1.5.5-r.5"
{%- elif driver == "oracledb" %}
		"oracledb": "^6.10.0"
{%- elif driver == "mssql" %}
		"mssql": "^11.0.2"
{%- elif driver == "kysely-mssql" %}
		"kysely": "^0.28.17",
		"tarn": "^3.1.2",
		"tedious": "^20.3.3"
{%- elif driver == "snowflake" %}
		"snowflake-sdk": "^2.4.3"
{%- endif %}
	}{% endif %},
	"devDependencies": {
{%- if (driver == "pg" or driver == "kysely-pg") and options.structs_only != "true" %}
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
{%- elif driver == "better-sqlite3" or driver == "kysely-sqlite" %}
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^26.6.4",
{%- elif driver == "mssql" %}
		"@types/mssql": "^12.3.0",
		"@types/node": "^26.6.4",
{%- elif driver == "oracledb" %}
		"@types/node": "^26.6.4",
		"@types/oracledb": "^7.0.3",
{%- else %}
		"@types/node": "^26.6.4",
{%- endif %}
		"tsx": "^4.23.15",
		"typescript": "^5.9.3"
	}
}
