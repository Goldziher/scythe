        if (inSingle) {
            current.append(ch)
            if (ch == '\'') inSingle = false
            i++
            continue
        }
        if (inDouble) {
            current.append(ch)
            if (ch == '"') inDouble = false
            i++
            continue
        }
        if (ch == '-' && i + 1 < sql.length && sql[i + 1] == '-') {
            inLineComment = true
            current.append(ch)
            i++
            continue
        }
        when {
            ch == '\'' -> {
                inSingle = true
                current.append(ch)
                i++
            }
            ch == '"' -> {
                inDouble = true
                current.append(ch)
                i++
            }
            ch == '$' -> {
                val match = Regex("^\\$[A-Za-z0-9_]*\\$").find(sql.substring(i))
                if (match != null) {
                    dollarTag = match.value
