{%- elif driver == "amphp" %}

{#- MysqlConfig has no fromArray(); fromString() wants amphp's own
    `host=..;db=..` key syntax rather than a URL, so the constructor is the
    direct route from parse_database_url's output.

    A single connection, NOT a MysqlConnectionPool -- unlike the postgresql
    branch above, which can pool safely because it reads generated ids back
    through RETURNING. MySQL's GetLastInsertUser resolves LAST_INSERT_ID(),
    which is scoped to the connection that ran the INSERT, so a pool hands
    the follow-up SELECT a different connection and it finds no row. #}
function create_connection(string $url): \Amp\Mysql\MysqlConnection
{
    $params = parse_database_url($url);
    $config = new \Amp\Mysql\MysqlConfig(
        host: $params['host'],
        port: (int) $params['port'],
        user: $params['user'],
        password: $params['password'],
        database: $params['dbname'],
    );
    return \Amp\Mysql\connect($config);
}
