{% if engine == "postgresql" -%}
function setup_schema({% if driver == "pdo" %}PDO {% endif %}$pdo): void
{
    $pdo->{% if driver == "amphp" %}query{% else %}exec{% endif %}("DROP TABLE IF EXISTS user_tags CASCADE");
    $pdo->{% if driver == "amphp" %}query{% else %}exec{% endif %}("DROP TABLE IF EXISTS tags CASCADE");
    $pdo->{% if driver == "amphp" %}query{% else %}exec{% endif %}("DROP TABLE IF EXISTS orders CASCADE");
    $pdo->{% if driver == "amphp" %}query{% else %}exec{% endif %}("DROP TABLE IF EXISTS users CASCADE");
    $pdo->{% if driver == "amphp" %}query{% else %}exec{% endif %}("DROP TYPE IF EXISTS user_status CASCADE");
    $pdo->{% if driver == "amphp" %}query{% else %}exec{% endif %}("DROP TYPE IF EXISTS user_address CASCADE");
    $schema_path = __DIR__ . '/../sql/pg/schema.sql';
    $schema_sql = file_get_contents($schema_path);
    if ($schema_sql === false) {
        throw new RuntimeException("Failed to read schema file: {$schema_path}");
    }
    $pdo->{% if driver == "amphp" %}query{% else %}exec{% endif %}($schema_sql);
}
