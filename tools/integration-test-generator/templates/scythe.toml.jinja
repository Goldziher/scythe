[scythe]
version = "1"

[[sql]]
name = "main"
engine = "{{ engine }}"
schema = ["{{ schema_dir }}/{{ schema_file }}"]
queries = ["{{ queries_dir }}/*.sql"]

[[sql.gen]]
backend = "{{ backend }}"
{%- if language == "java" %}
output = "src/main/java/generated"
{%- elif language == "kotlin" %}
output = "src/main/kotlin/generated"
{%- elif language == "rust" and driver != "tokio-postgres" %}
output = "src"
structs_only = "true"
{%- elif language == "rust" %}
output = "src"
{%- else %}
output = "generated"
{%- endif %}
{%- if options.row_type %}
row_type = "{{ options.row_type }}"
{%- endif %}
{%- if options.outer_join_unions %}
outer_join_unions = "{{ options.outer_join_unions }}"
{%- endif %}
{%- if options.structs_only and language != "rust" %}
structs_only = "{{ options.structs_only }}"
{%- endif %}
