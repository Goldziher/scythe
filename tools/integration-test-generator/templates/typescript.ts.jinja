		assert(
			activeUsers[0]!.name === "Alice",
			"ListActiveUsers",
			"first user should be Alice",
		);
		console.log("PASS: ListActiveUsers");

		// Test: CreateOrder
		const order = await createOrder(db, 1, userId, "99.95", "first order");
		assert(order !== null, "CreateOrder", "order should not be null");
