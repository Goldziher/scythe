const DATABASE_URL =
	process.env["{{ connection_env }}"] ??
	"{% if engine == "postgresql" %}postgres://scythe:scythe@localhost:5432/scythe_test{% elif engine == "mysql" or engine == "mariadb" %}mysql://root@localhost:3306/scythe_test{% elif engine == "sqlite" %}test.db{% elif engine == "oracle" %}oracle://scythe:scythe@localhost:1521/XEPDB1{% elif engine == "mssql" %}sqlserver://sa:Scythe_Test1@localhost:1433?database=scythe_test{% elif engine == "snowflake" %}snowflake://account:password@host/database/schema{% endif %}";
{% if driver == "pg" %}
const pool = new pg.Pool({ connectionString: DATABASE_URL });
{%- elif driver == "kysely-pg" %}
const db = new Kysely<any>({
	dialect: new PostgresDialect({ pool: new pg.Pool({ connectionString: DATABASE_URL }) }),
});
{%- elif driver == "postgres" %}
const sql = postgres(DATABASE_URL);
{%- elif driver == "kysely-mysql2" or driver == "kysely-mariadb" %}
const db = new Kysely<any>({
	dialect: new MysqlDialect({ pool: mysql.createPool(DATABASE_URL) }),
});
{%- elif driver == "kysely-sqlite" %}
const db = new Kysely<any>({
	dialect: new SqliteDialect({ database: new Database(DATABASE_URL) }),
});
{%- elif driver == "better-sqlite3" %}
const db = new Database(DATABASE_URL);
{%- elif driver == "node-sqlite" %}
const db = new DatabaseSync(DATABASE_URL);
{%- elif driver == "wasm-sqlite" %}
const sqlite3 = await sqlite3InitModule();
const db = new sqlite3.oo1.DB(DATABASE_URL, "c");
{%- elif driver == "kysely-mssql" %}
const mssqlUrl = new URL(DATABASE_URL);
const db = new Kysely<any>({
	dialect: new MssqlDialect({
		tarn: { ...Tarn, options: { min: 0, max: 10 } },
		tedious: {
			...Tedious,
			connectionFactory: () =>
				new Tedious.Connection({
					server: mssqlUrl.hostname,
					authentication: {
						type: "default",
						options: {
							userName: mssqlUrl.username,
							password: decodeURIComponent(mssqlUrl.password),
						},
					},
					options: {
						port: parseInt(mssqlUrl.port) || 1433,
						database: mssqlUrl.searchParams.get("database") || "master",
						trustServerCertificate: true,
					},
				}),
		},
	}),
});
{%- endif %}

let exitCode = 0;

function assert(condition: boolean, testName: string, detail: string): void {
	if (!condition) {
		console.error(`FAIL: ${testName}: ${detail}`);
		exitCode = 1;
	}
}
{% if driver == "snowflake" %}
function connect(conn: Connection): Promise<void> {
	return new Promise((resolve, reject) => {
		conn.connect((err) => (err ? reject(err) : resolve()));
	});
}

function execute(conn: Connection, sqlText: string): Promise<void> {
	return new Promise((resolve, reject) => {
		conn.execute({
			sqlText,
			complete: (err) => (err ? reject(err) : resolve()),
		});
	});
}

function destroy(conn: Connection): Promise<void> {
	return new Promise((resolve, reject) => {
		conn.destroy((err) => (err ? reject(err) : resolve()));
	});
}
{%- endif %}

