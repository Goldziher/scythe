<?xml version="1.0" encoding="UTF-8"?>
<project
  xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
>
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.scythe</groupId>
  <artifactId>{{ backend_name }}-integration</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    {%- if driver == "r2dbc" and engine == "postgresql" %}
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>r2dbc-postgresql</artifactId>
        <version>1.0.7.RELEASE</version>
      </dependency>
    {%- elif driver == "r2dbc" and (engine == "mysql" or engine == "mariadb") %}
      <dependency>
        <groupId>io.asyncer</groupId>
        <artifactId>r2dbc-mysql</artifactId>
        <version>1.3.1</version>
      </dependency>
    {%- elif driver == "r2dbc" %}
      <!-- No java-r2dbc-sqlite/kotlin-r2dbc-sqlite project exists: there is no
           io.r2dbc:r2dbc-sqlite artifact on Maven Central. See board #212. -->
    {%- endif %}
    {%- if driver == "r2dbc" %}
      <!-- The generated Queries.java/kt imports reactor.core.publisher.Mono/Flux
           directly, so this is a compile-time dependency of the generated code,
           not merely a transitive runtime dependency of the r2dbc driver. -->
      <dependency>
        <groupId>io.projectreactor</groupId>
        <artifactId>reactor-core</artifactId>
        <version>3.7.4</version>
      </dependency>
      <!-- The blocking JDBC driver as well, and not by accident: R2DBC has no
           way to run a multi-statement DDL script, so the harness sets the
           schema up over java.sql.DriverManager before any reactive code runs.
           Without this the project compiles and then dies at run time with
           "No suitable driver found for jdbc:...". -->
      {%- if engine == "postgresql" %}
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>42.7.12</version>
      </dependency>
      {%- elif engine == "mysql" or engine == "mariadb" %}
      <dependency>
        <groupId>com.mysql</groupId>
        <artifactId>mysql-connector-j</artifactId>
        <version>9.0.0</version>
      </dependency>
      {%- endif %}
    {%- elif engine == "postgresql" %}
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>42.7.12</version>
      </dependency>
    {%- elif engine == "mysql" or engine == "mariadb" %}
      <dependency>
        <groupId>com.mysql</groupId>
        <artifactId>mysql-connector-j</artifactId>
        <version>9.0.0</version>
      </dependency>
    {%- elif engine == "sqlite" %}
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>3.45.1.0</version>
      </dependency>
    {%- elif engine == "duckdb" %}
      <dependency>
        <groupId>org.duckdb</groupId>
        <artifactId>duckdb_jdbc</artifactId>
        <version>1.5.5.1</version>
      </dependency>
    {%- elif engine == "oracle" %}
      <dependency>
        <groupId>com.oracle.database.jdbc</groupId>
        <artifactId>ojdbc11</artifactId>
        <version>23.4.0.24.05</version>
      </dependency>
    {%- elif engine == "mssql" %}
      <dependency>
        <groupId>com.microsoft.sqlserver</groupId>
        <artifactId>mssql-jdbc</artifactId>
        <version>12.4.1.jre11</version>
      </dependency>
    {%- elif engine == "snowflake" %}
      <dependency>
        <groupId>net.snowflake</groupId>
        <artifactId>snowflake-jdbc</artifactId>
        <version>4.0.2</version>
      </dependency>
    {%- elif engine == "redshift" %}
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>42.7.12</version>
      </dependency>
    {%- endif %}
    <dependency>
      <groupId>com.google.code.findbugs</groupId>
      <artifactId>jsr305</artifactId>
      <version>3.0.2</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <mainClass>IntegrationTest</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
