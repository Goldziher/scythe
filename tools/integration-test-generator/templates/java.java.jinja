    private static void testCreateOrder(ConnectionFactory cf) {
        String name = "CreateOrder";
        try {
            {%- if engine == "mariadb" %}
            // createOrder is `:one` for mariadb -- there is no GetLastInsertOrder
            // query for this engine (mysql's shape, not mariadb's).
            var order = Queries.createOrder(cf, createdUserId, new BigDecimal("99.99"), "Test order").block();
            {%- else %}
            Queries.createOrder(cf, createdUserId, new BigDecimal("99.99"), "Test order").block();
            var order = Queries.getLastInsertOrder(cf).block();
            {%- endif %}
            if (order == null) {
                fail(name, "returned null");
                return;
