                }
                i++;
                continue;
            }
            if (inSingle) {
                current.append(ch);
                if (ch == '\'') inSingle = false;
                i++;
                continue;
            }
            if (inDouble) {
                current.append(ch);
                if (ch == '"') inDouble = false;
                i++;
                continue;
            }
            if (ch == '-' && i + 1 < sql.length() && sql.charAt(i + 1) == '-') {
                inLineComment = true;
                current.append(ch);
                i++;
                continue;
            }
            if (ch == '\'') {
                inSingle = true;
                current.append(ch);
                i++;
                continue;
            }
            if (ch == '"') {
                inDouble = true;
                current.append(ch);
                i++;
                continue;
            }
            if (ch == '$') {
                java.util.regex.Matcher matcher =
                    java.util.regex.Pattern.compile("^\\$[A-Za-z0-9_]*\\$").matcher(sql.substring(i));
                if (matcher.find()) {
                    dollarTag = matcher.group();
                    current.append(dollarTag);
