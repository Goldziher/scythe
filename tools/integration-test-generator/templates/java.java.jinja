            if (ch == '"') {
                inDouble = true;
                current.append(ch);
                i++;
                continue;
            }
            if (ch == '$') {
                java.util.regex.Matcher matcher =
                    java.util.regex.Pattern.compile("^\\$[A-Za-z0-9_]*\\$").matcher(sql.substring(i));
                if (matcher.find()) {
                    dollarTag = matcher.group();
                    current.append(dollarTag);
                    i += dollarTag.length();
                    continue;
                }
            }
            if (ch == ';') {
                statements.add(current.toString());
                current.setLength(0);
