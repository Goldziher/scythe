fun testCreateUser(conn: java.sql.Connection) {
    val name = "CreateUser"
    try {
        createUser(conn, "Alice", "alice@example.com", "active")
        // SQLite: use last_insert_rowid() to get the new user's id
        val lastId = conn.createStatement().use { stmt ->
            stmt.executeQuery("SELECT last_insert_rowid()").use { rs ->
                rs.next()
                // last_insert_rowid() is a 64-bit rowid, and SQLite INTEGER
                // columns generate as Long.
                rs.getLong(1)
            }
        }
        val user = getUserById(conn, lastId)
        if (user == null) {
            fail(name, "returned null")
            return
        }
        if (user.name != "Alice") {
            fail(name, "expected name Alice, got ${user.name}")
