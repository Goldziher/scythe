{%- macro harness_state() -%}
var passed = 0
var failed = 0

fun pass(name: String) {
    println("PASS: $name")
    passed++
}

fun fail(name: String, message: String) {
    println("FAIL: $name - $message")
    failed++
}

fun fail(name: String, e: Exception) {
    println("FAIL: $name - ${e.message}")
    failed++
}
{%- endmacro %}

{#
  The caller supplies the family adapter: connection setup plus the ordered
  JDBC, Exposed, or R2DBC test invocations. Result accounting and process
  exit semantics stay canonical across every rendered Kotlin harness.
#}
{%- macro canonical_program() -%}
fun main() {
{{- caller() }}

    println()
    println("Results: $passed passed, $failed failed")
    if (failed > 0) {
        exitProcess(1)
    }
    println("ALL TESTS PASSED")
}
{%- endmacro %}

