module scythe-integration/{{ backend_name }}

{# ~keep Match each generated module's `go` directive to its resolved driver
   graph: pgx, godror, DuckDB, MSSQL and Snowflake now need Go 1.26; the
   MySQL and SQLite modules still build with 1.25.7. -#}
go {% if driver == "pgx" or driver == "godror" or (driver == "database-sql" and (engine == "duckdb" or engine == "mssql" or engine == "snowflake")) %}1.26.0{% else %}1.25.7{% endif %}

require (
{%- if driver == "pgx" %}
  github.com/jackc/pgx/v5 v5.11.0
  github.com/shopspring/decimal v1.4.0
{%- elif driver == "database-sql" and (engine == "mysql" or engine == "mariadb") %}
  github.com/go-sql-driver/mysql v1.10.1
{%- elif driver == "database-sql" and engine == "sqlite" %}
  github.com/mattn/go-sqlite3 v1.14.52
{%- elif driver == "database-sql" and engine == "duckdb" %}
  github.com/marcboeker/go-duckdb/v2 v2.4.3
{%- elif driver == "database-sql" and engine == "mssql" %}
  github.com/microsoft/go-mssqldb v1.11.2
{%- elif driver == "database-sql" and engine == "snowflake" %}
  github.com/snowflakedb/gosnowflake v1.19.1
{%- elif driver == "godror" %}
  github.com/godror/godror v0.51.5
{%- endif %}
)
