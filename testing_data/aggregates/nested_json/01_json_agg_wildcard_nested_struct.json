  "name": "json_agg_wildcard_nested_struct",
  "query_sql": "-- @name GetUserOrders\n-- @returns :many\nSELECT u.id, json_agg(o.*) AS orders FROM users u JOIN orders o ON o.user_id = u.id GROUP BY u.id;",
  "schema_sql": [
    "CREATE TYPE order_status AS ENUM ('pending', 'shipped');",
    "CREATE TABLE users (id SERIAL PRIMARY KEY, name TEXT NOT NULL);",
