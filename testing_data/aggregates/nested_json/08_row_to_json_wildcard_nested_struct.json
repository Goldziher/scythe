{
  "category": "aggregates/nested_json",
  "config": { "engine": "postgresql" },
  "description": "row_to_json over a relation wildcard infers a nested struct without the array wrapper json_agg adds",
  "expected": {
    "generated_code": {
      "rust-sqlx": { "degraded_nested_structs": [] },
      "rust-tokio-postgres": { "degraded_nested_structs": [] },
      "python-psycopg3": { "degraded_nested_structs": [] },
      "go-pgx": { "degraded_nested_structs": [] },
      "php-pdo": { "degraded_nested_structs": [] },
      "php-amphp": { "degraded_nested_structs": [] },
      "python-asyncpg": {
        "degraded_nested_structs": [
          { "column": "payload", "struct_name": "GetOrderPayloadRowPayload", "fallback_type": "json" }
        ]
      },
      "typescript-pg": {
        "degraded_nested_structs": [
          { "column": "payload", "struct_name": "GetOrderPayloadRowPayload", "fallback_type": "json" }
        ]
      },
      "java-jdbc": {
        "degraded_nested_structs": [
          { "column": "payload", "struct_name": "GetOrderPayloadRowPayload", "fallback_type": "json" }
        ]
      }
    },
    "query": {
      "columns": [
        {
          "name": "payload",
          "note": "row_to_json over a null-extended row returns SQL NULL, so the column is nullable and there is no element to wrap",
          "nullable": true,
          "type": "json_nested<GetOrderPayloadRowPayload>"
        }
      ],
      "command": "many",
      "name": "GetOrderPayload",
      "nested_structs": [
        {
          "fields": [
            { "name": "id", "nullable": false, "type": "int32" },
            { "name": "user_id", "nullable": false, "type": "int32" },
            { "name": "notes", "nullable": true, "type": "string" }
          ],
          "name": "get_order_payload_row_payload"
        }
      ],
      "params": []
    },
    "success": true
  },
  "name": "row_to_json_wildcard_nested_struct",
  "query_sql": "-- @name GetOrderPayload\n-- @returns :many\nSELECT row_to_json(o.*) AS payload FROM orders o;",
  "schema_sql": ["CREATE TABLE orders (id SERIAL PRIMARY KEY, user_id INTEGER NOT NULL, notes TEXT);"],
  "source": "original",
  "tags": ["aggregate", "row_to_json", "nested"]
}
